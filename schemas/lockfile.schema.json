{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepm.dev/schemas/lockfile.schema.json",
  "title": "IEPM lockfile",
  "type": "object",
  "required": ["schema", "game", "registry_revision", "packages", "install_order"],
  "properties": {
    "schema": { "const": 1 },
    "game": { "type": "object", "required": ["target"], "properties": { "target": { "type": "string" }, "version": { "type": "string" }, "fingerprint": { "type": "string" } }, "additionalProperties": false },
    "registry_revision": { "type": "string" },
    "packages": { "type": "array", "items": { "type": "object", "required": ["package", "version", "phase", "provenance"], "properties": { "package": { "type": "string" }, "version": { "type": "string" }, "phase": { "type": "string" }, "artifact_sha256": { "type": "string" }, "components": { "type": "array", "items": { "type": "string" } }, "provenance": { "enum": ["declared", "derived", "verified", "community", "unverified"] } }, "additionalProperties": false } },
    "install_order": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
