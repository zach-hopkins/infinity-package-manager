{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepm.dev/schemas/lockfile.schema.json",
  "title": "IEPM schema-2 lockfile",
  "type": "object",
  "required": ["schema", "environments", "registry_revision", "toolchain", "packages", "execution", "execution_readiness"],
  "properties": {
    "schema": { "const": 2 },
    "environments": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/environment" } },
    "registry_revision": { "type": "string" },
    "toolchain": { "type": "object", "required": ["iepm"], "properties": { "iepm": { "type": "string" }, "weidu": { "type": "string" } }, "additionalProperties": false },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } },
    "execution": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "execution_readiness": { "enum": ["executable", "analysis-only"] },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "environment": {
      "type": "object", "required": ["target"],
      "properties": { "target": { "enum": ["bgee", "bg2ee", "eet"] }, "version": { "type": "string" }, "fingerprint": { "type": "object", "required": ["profile", "value"], "properties": { "profile": { "type": "string" }, "value": { "type": "string" } }, "additionalProperties": false }, "platform": { "enum": ["windows", "linux", "macos"] }, "store": { "type": "string" }, "language": { "type": "string" } }, "additionalProperties": false
    },
    "artifact": {
      "type": "object", "required": ["url", "sha256"],
      "properties": { "url": { "type": "string", "format": "uri" }, "mirrors": { "type": "array", "items": { "type": "string", "format": "uri" } }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "format": { "enum": ["zip"] }, "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] } }, "architectures": { "type": "array", "items": { "enum": ["x86", "x86-64", "aarch64"] } } }, "additionalProperties": false
    },
    "package": {
      "type": "object", "required": ["package", "release_id", "version", "environment", "phase", "provenance"],
      "properties": {
        "package": { "type": "string" }, "release_id": { "type": "string" }, "version": { "type": "string" }, "environment": { "type": "string" }, "phase": { "type": "string" }, "artifact": { "$ref": "#/$defs/artifact" },
        "materialization": { "type": "object", "properties": { "source_root": { "type": "string" }, "include": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
        "components": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "weidu": { "type": "object", "required": ["tp2"], "properties": { "tp2": { "type": "string" }, "label": { "type": "string" }, "number": { "type": "integer" }, "subcomponent": { "type": "string" } }, "additionalProperties": false } }, "additionalProperties": false } },
        "language": { "type": "string" }, "installer_inputs": { "type": "object", "additionalProperties": { "type": "string" } }, "dependencies": { "type": "array" }, "provenance": { "enum": ["declared", "derived", "verified", "community", "unverified"] }
      }, "additionalProperties": false
    },
    "node": { "type": "object", "required": ["id", "package", "environment", "phase"], "properties": { "id": { "type": "string" }, "package": { "type": "string" }, "environment": { "type": "string" }, "phase": { "type": "string" }, "predecessors": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
