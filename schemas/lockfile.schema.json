{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepm.dev/schemas/lockfile.schema.json",
  "title": "IEPM lockfile",
  "type": "object",
  "required": ["schema", "game", "registry_revision", "toolchain", "packages", "install_order"],
  "properties": {
    "schema": { "const": 1 },
    "game": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "type": "string" },
        "version": { "type": "string" },
        "fingerprint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "registry_revision": { "type": "string" },
    "toolchain": {
      "type": "object",
      "required": ["iepm"],
      "properties": {
        "iepm": { "type": "string" },
        "weidu": { "type": "string" }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "version", "phase", "provenance"],
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "phase": { "type": "string" },
          "artifact": {
            "type": "object",
            "required": ["url", "sha256"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "format": { "enum": ["zip"] },
              "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] } }
            },
            "additionalProperties": false
          },
          "components": { "type": "array", "items": { "type": "string" } },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["package"],
              "properties": {
                "package": { "type": "string" },
                "version": { "type": "string" },
                "components": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "provenance": { "enum": ["declared", "derived", "verified", "community", "unverified"] }
        },
        "additionalProperties": false
      }
    },
    "install_order": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
