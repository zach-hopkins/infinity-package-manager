{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepm.dev/schemas/package.schema.json",
  "title": "IEPM registry package",
  "type": "object",
  "required": ["schema", "package", "releases"],
  "properties": {
    "schema": { "const": 1 },
    "package": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "compatibility", "install", "provenance"],
        "properties": {
          "version": { "type": "string" },
          "artifact": { "type": "object", "required": ["url", "sha256"], "properties": { "url": { "type": "string", "format": "uri" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "format": { "enum": ["zip"], "default": "zip" }, "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] }, "uniqueItems": true } }, "additionalProperties": false },
          "compatibility": { "type": "object", "required": ["games"], "properties": { "games": { "type": "array", "items": { "enum": ["bgee", "bg2ee", "eet"] } } } },
          "install": { "type": "object", "required": ["phase"], "properties": { "phase": { "enum": ["preprocess", "bgee", "eet-import", "eet", "eet-end", "post-eet-end"] }, "before": { "type": "array", "items": { "type": "string" } }, "after": { "type": "array", "items": { "type": "string" } } } },
          "provenance": { "enum": ["declared", "derived", "verified", "community", "unverified"] },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["package"],
              "properties": { "package": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "version": { "type": "string", "description": "A SemVer version requirement" }, "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } },
              "additionalProperties": false
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "provides": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name"],
                    "properties": { "name": { "type": "string" }, "exclusive": { "type": "boolean" } },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
