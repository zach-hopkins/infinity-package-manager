{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iepm.dev/schemas/manifest.schema.json",
  "title": "IEPM schema-2 manifest",
  "type": "object",
  "required": ["schema", "environments", "mods"],
  "properties": {
    "schema": { "const": 2 },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/environment" }
    },
    "mods": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          {
            "type": "object",
            "required": ["package"],
            "properties": {
              "package": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "version": { "type": "string", "description": "Exact opaque release ID/version, id:<release-id>, or an explicit SemVer range" },
              "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "environment": { "type": "string" },
              "language": { "type": "string" },
              "installer_inputs": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "enum": ["bgee", "bg2ee", "eet"] },
        "after_eet_import": { "enum": ["bgee", "bg2ee", "eet"] },
        "version": { "type": "string" },
        "fingerprint": {
          "type": "object",
          "required": ["profile", "value"],
          "properties": { "profile": { "type": "string" }, "value": { "type": "string" } },
          "additionalProperties": false
        },
        "platform": { "enum": ["windows", "linux", "macos"] },
        "store": { "type": "string" },
        "language": { "type": "string" },
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}_[A-Za-z]{2,4}$" },
        "baseline": {
          "type": "array",
          "description": "Ordered WeiDU entries expected to already exist in this environment; these are preflight assertions, not requested installs.",
          "items": {
            "type": "object",
            "required": ["tp2", "language", "component"],
            "properties": {
              "tp2": { "type": "string" },
              "language": { "type": "integer", "minimum": 0 },
              "component": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
